# Lyzr University - Environment Configuration Template
# Copy this file to .env and populate with your credentials.

# Thinkific Admin API & SSO Integration Credentials
THINKIFIC_SUBDOMAIN=lyzr
THINKIFIC_API_KEY=your_thinkific_api_key_here
THINKIFIC_API_ACCESS_TOKEN=your_thinkific_access_token_here
THINKIFIC_SSO_SIGNING_SECRET=your_thinkific_sso_signing_secret_here

# Descript API Credentials
DESCRIPT_BEARER_TOKEN=your_descript_bearer_token_here
DESCRIPT_SECRET=your_descript_secret_here

# Google / YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
