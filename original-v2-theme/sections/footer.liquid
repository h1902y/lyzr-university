{% comment %}
  Lyzr University — corporate footer.
  Structure + links are hard-coded here (theme code) so they ship in the zip and render
  site-wide; the block-based flat nav is intentionally replaced. Copyright + Thinkific
  white-label logic preserved from the stock section.
{% endcomment %}
<footer class="footer lyzr-footer hidden-print" data-preview-item="footer">
  <div class="lyzr-footer__inner">
    <div class="lyzr-footer__grid">

      <div class="lyzr-footer__brand">
        <span class="lyzr-footer__wordmark">Lyzr <em>University</em></span>
        <p class="lyzr-footer__tagline">Learn to build production-grade AI agents — visually in Lyzr’s AI Studio, or in code with the ADK.</p>
        <ul class="lyzr-footer__social">
          <li><a href="https://www.linkedin.com/company/lyzr" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.24 8h4.52v14H.24V8zm7.5 0h4.33v1.9h.06c.6-1.14 2.07-2.34 4.26-2.34 4.56 0 5.4 3 5.4 6.9V22h-4.52v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.49V22H7.74V8z"/></svg></a></li>
          <li><a href="https://www.youtube.com/@LyzrAI" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a></li>
          <li><a href="https://x.com/lyzrai" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.63 7.58H.49l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.48 3.24H4.29L17.61 20.65z"/></svg></a></li>
          <li><a href="https://www.instagram.com/lyzr.ai" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zm0 2.88a6.96 6.96 0 1 0 0 13.92 6.96 6.96 0 0 0 0-13.92zm0 11.48a4.52 4.52 0 1 1 0-9.04 4.52 4.52 0 0 1 0 9.04zm7.24-11.75a1.63 1.63 0 1 1-3.25 0 1.63 1.63 0 0 1 3.25 0z"/></svg></a></li>
        </ul>
      </div>

      <nav class="lyzr-footer__col" aria-label="Product">
        <h4 class="lyzr-footer__heading">Product</h4>
        <ul>
          <li><a href="https://studio.lyzr.ai" target="_blank" rel="noopener">AI Studio</a></li>
          <li><a href="https://architect.new" target="_blank" rel="noopener">Architect</a></li>
          <li><a href="https://docs.lyzr.ai" target="_blank" rel="noopener">ADK</a></li>
          <li><a href="https://www.lyzr.ai/pricing" target="_blank" rel="noopener">Pricing</a></li>
        </ul>
      </nav>

      <nav class="lyzr-footer__col" aria-label="Learn">
        <h4 class="lyzr-footer__heading">Learn</h4>
        <ul>
          <li><a href="/collections">All Courses</a></li>
          <li><a href="/collections/foundations">Foundations</a></li>
          <li><a href="https://docs.lyzr.ai" target="_blank" rel="noopener">Docs</a></li>
          <li><a href="/hub/community/415845">Community</a></li>
        </ul>
      </nav>

      <nav class="lyzr-footer__col" aria-label="Company">
        <h4 class="lyzr-footer__heading">Company</h4>
        <ul>
          <li><a href="https://www.lyzr.ai" target="_blank" rel="noopener">About</a></li>
          <li><a href="https://www.lyzr.ai/blog" target="_blank" rel="noopener">Blog</a></li>
          <li><a href="https://www.lyzr.ai/book-demo" target="_blank" rel="noopener">Contact</a></li>
        </ul>
      </nav>

    </div>

    <div class="lyzr-footer__bar">
      {% if section.settings.show_copyright %}
        <span class="lyzr-footer__legal">{% if section.settings.custom_copyright != blank and section.settings.custom_copyright != "" %}{{ section.settings.custom_copyright }}{% else %}{{ site.copyright }}{% endif %}</span>
      {% endif %}
      {% unless site.white_labelling_activated %}
        <div class="footer__white-label">
          <a href="//www.thinkific.com/?utm_source={{ site.subdomain }}&utm_medium=powered-by&utm_campaign=Referral" target="_blank" rel="noopener">
            {% include 'thinkific_branding' %}
            <span class="sr-only">{{ 'liquid.accessibility.new_window_warning' | translate }}</span>
          </a>
        </div>
      {% endunless %}
    </div>
  </div>
</footer>

{% schema %}
{
  "label":"Footer",
  "settings":[
    {
      "label":"Copyright",
      "settings":[
        {
          "type":"textarea",
          "id":"custom_copyright",
          "label":"Custom copyright",
          "description":"",
          "default":""
        },
        {
          "type":"checkbox",
          "id":"show_copyright",
          "label":"Show copyright",
          "default":true
        }
      ]
    }
  ]
}
{% endschema %}
