// Overrides
// ======================================

// ══════════════════════════════════════════════════════════════════════
//  Lyzr University — storefront polish (layered over Vogue)
//  Brand · Ferra #71514F · White Amber #F3EFEA · Cream #E3D0C2 · Congo #4A2F2D
// ══════════════════════════════════════════════════════════════════════

// ── "Choose your track" — premium, audience-led dark cards ──────────────
.track-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  height: 100%;
  min-height: 264px;
  padding: 2rem 1.75rem;
  border-radius: 18px;
  background: linear-gradient(158deg, #4A2F2D 0%, #2B1B1A 100%);
  border: 1px solid rgba(227, 208, 194, 0.14);
  color: #F3EFEA;
  text-decoration: none;
  box-shadow: 0 2px 8px rgba(39, 20, 18, 0.20);
  overflow: hidden;
  transition: transform .32s cubic-bezier(.2, .7, .2, 1),
              box-shadow .32s ease, border-color .32s ease;

  &__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1.4rem;
    border-radius: 14px;
    background: rgba(227, 208, 194, 0.10);
    color: #E3D0C2;
    transition: background .32s ease;

    svg { width: 26px; height: 26px; }
  }

  &__kicker {
    margin-bottom: .55rem;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #C99B86;
  }

  &__title {
    margin-bottom: .55rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.12;
    color: #F3EFEA;
  }

  &__desc {
    font-size: .95rem;
    line-height: 1.55;
    color: rgba(243, 239, 234, 0.72);
  }

  &__cta {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: auto;
    padding-top: 1.4rem;
    font-size: .9rem;
    font-weight: 600;
    color: #E3D0C2;
  }

  &__arrow { transition: transform .3s ease; }

  &:hover {
    transform: translateY(-8px);
    box-shadow: 0 28px 52px -18px rgba(39, 20, 18, 0.55);
    border-color: rgba(227, 208, 194, 0.34);

    .track-card__icon  { background: rgba(227, 208, 194, 0.18); }
    .track-card__arrow { transform: translateX(5px); }
  }
}

// grid rhythm for the three tracks
.course-categories {
  .products__list      { row-gap: 1.25rem; }
  .products__list-item { padding-bottom: 1.25rem; }
}

// ── Global brand polish ─────────────────────────────────────────────────
// Editorial section headings
.section__heading,
.section__headings h2 { letter-spacing: -0.015em; }

// Primary buttons — warm, soft-rounded, subtle lift
.button-primary,
.button--primary {
  border-radius: 10px;
  transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;

  &:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -8px rgba(74, 47, 45, 0.5);
  }
}

// ── Footer — dark corporate footer (bookends hero + cards) ──────────────
.lyzr-footer {
  background: linear-gradient(180deg, #2B1B1A 0%, #201312 100%);
  color: rgba(243, 239, 234, 0.80);
  padding: 4rem 0 2rem;

  &__inner { max-width: 1180px; margin: 0 auto; padding: 0 2rem; }

  &__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  &__wordmark {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    color: #F3EFEA;
    em { font-style: italic; color: #C99B86; }
  }

  &__tagline {
    margin: .9rem 0 1.4rem;
    max-width: 340px;
    font-size: .9rem;
    line-height: 1.6;
    color: rgba(243, 239, 234, 0.55);
  }

  &__social {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;

    a {
      display: inline-flex;
      color: rgba(243, 239, 234, 0.65);
      transition: color .2s ease;
      &:hover { color: #E3D0C2; }
      svg { width: 20px; height: 20px; }
    }
  }

  &__heading {
    margin: 0 0 1.1rem;
    font-size: .74rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #C99B86;
  }

  &__col ul { list-style: none; margin: 0; padding: 0; }
  &__col li { margin-bottom: .65rem; }
  &__col a {
    font-size: .92rem;
    color: rgba(243, 239, 234, 0.72);
    text-decoration: none;
    transition: color .2s ease;
    &:hover { color: #F3EFEA; }
  }

  &__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(227, 208, 194, 0.12);
    font-size: .82rem;
    color: rgba(243, 239, 234, 0.5);
    a { color: inherit; }
  }

  @media (max-width: 900px) { &__grid { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  @media (max-width: 560px) { &__grid { grid-template-columns: 1fr; } }
}

// ══════════════════════════════════════════════════════════════════════
//  Bespoke home page (hand-coded — pages/home_landing_page.liquid)
// ══════════════════════════════════════════════════════════════════════
.lyzr-home { overflow: visible; overflow-x: clip; }  // never clip vertically (theme body is flex/100vh)

// Buttons
.lyzr-btn {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .85rem 1.6rem;
  border-radius: 12px;
  font-family: 'Noto Sans', 'Inter', system-ui, sans-serif;
  font-size: .98rem;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, border-color .2s ease;

  &:hover { transform: translateY(-2px); }

  &--primary { background: #71514F; color: #F3EFEA; box-shadow: 0 8px 22px -10px rgba(74,47,45,.6);
    &:hover { background: #5E4240; box-shadow: 0 14px 30px -12px rgba(74,47,45,.7); } }
  &--ghost { background: transparent; color: #F3EFEA; border: 1.5px solid rgba(243,239,234,.4);
    &:hover { border-color: #F3EFEA; background: rgba(243,239,234,.06); } }
  &--light { background: #F3EFEA; color: #4A2F2D;
    &:hover { background: #FFFFFF; box-shadow: 0 14px 30px -12px rgba(0,0,0,.35); } }
  &--dark { background: #4A2F2D; color: #F3EFEA;
    &:hover { background: #3A2523; } }
  &--lg { padding: 1.05rem 2rem; font-size: 1.05rem; border-radius: 14px; }
}

// Hero
.lyzr-hero {
  position: relative;
  overflow: hidden;
  padding: 7rem 1.5rem 8rem;
  background: radial-gradient(120% 120% at 50% -10%, #5A3B38 0%, #3A2523 42%, #241615 100%);
  color: #F3EFEA;
  text-align: center;

  &__grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(227,208,194,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(227,208,194,.05) 1px, transparent 1px);
    background-size: 46px 46px;
  }
  &__glow {
    position: absolute; top: -22%; left: 50%; transform: translateX(-50%);
    width: 720px; height: 720px; pointer-events: none;
    background: radial-gradient(circle, rgba(190,125,112,.30) 0%, transparent 62%);
  }
  &__inner { position: relative; max-width: 820px; margin: 0 auto; }
  &__eyebrow {
    display: inline-block; margin-bottom: 1.25rem;
    font-size: .78rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: #C99B86;
  }
  &__title {
    margin: 0 0 1.4rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600; line-height: 1.02; letter-spacing: -.01em;
    font-size: clamp(3rem, 7vw, 5.2rem); color: #F3EFEA;
    em { font-style: italic; color: #C98B7C; }
  }
  &__sub { max-width: 620px; margin: 0 auto 2.4rem; font-size: 1.15rem; line-height: 1.6; color: rgba(243,239,234,.72); }
  &__actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
}

// Section blocks
.lyzr-block {
  padding: 5.5rem 1.5rem;

  &__head { max-width: 720px; margin: 0 auto 3rem; text-align: center; }
  &__kicker {
    display: inline-block; margin-bottom: .8rem;
    font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #B3786E;
  }
  &__title {
    margin: 0 0 .8rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600; line-height: 1.1; font-size: clamp(2rem, 4vw, 2.9rem); color: #27272A;
  }
  &__lead { margin: 0 auto; max-width: 560px; font-size: 1.08rem; line-height: 1.55; color: #6B5A54; }
  &__body { max-width: 1120px; margin: 0 auto; }
}
.lyzr-block--tracks { background: #E3D0C2; }
.lyzr-community-block .lyzr-btn { margin-top: 1.8rem; }

// Product CTA band (dark)
.lyzr-product {
  background: linear-gradient(155deg, #4A2F2D 0%, #2B1B1A 100%);
  color: #F3EFEA;
  text-align: center;

  &__inner { max-width: 680px; margin: 0 auto; }
  &__eyebrow {
    display: inline-block; margin-bottom: 1rem;
    font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #C99B86;
  }
  &__title {
    margin: 0 0 1rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600; font-size: clamp(2.2rem, 4.5vw, 3.2rem); line-height: 1.08; color: #F3EFEA;
  }
  &__sub { max-width: 520px; margin: 0 auto 2.2rem; font-size: 1.12rem; line-height: 1.6; color: rgba(243,239,234,.75); }
}

// Hero credibility pill
.lyzr-hero__pill {
  display: inline-flex; align-items: center; gap: .5rem;
  margin-bottom: 1.5rem;
  padding: .48rem 1.05rem;
  border-radius: 999px;
  border: 1px solid rgba(227,208,194,.22);
  background: rgba(227,208,194,.07);
  font-size: .8rem; font-weight: 600; letter-spacing: .03em; color: #E3D0C2;
}
.lyzr-hero__spark { color: #C98B7C; }

// How it works — 3 steps
.lyzr-steps__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
.lyzr-step {
  padding: 2.1rem 1.8rem;
  border-radius: 16px;
  background: #FFFFFF;
  border: 1px solid #EADFD5;
  box-shadow: 0 1px 3px rgba(74,47,45,.05);
  transition: transform .28s cubic-bezier(.2,.7,.2,1), box-shadow .28s ease;

  &:hover { transform: translateY(-5px); box-shadow: 0 18px 38px -16px rgba(74,47,45,.28); }

  &__num {
    display: inline-block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.1rem; font-weight: 600; line-height: 1; color: #C99B86;
  }
  &__title { margin: 1rem 0 .5rem; font-size: 1.15rem; font-weight: 600; color: #27272A; }
  &__desc { margin: 0; font-size: .95rem; line-height: 1.55; color: #6B5A54; }
}
@media (max-width: 760px) { .lyzr-steps__grid { grid-template-columns: 1fr; } }

// Why band — value props
.lyzr-why { padding-top: 4.5rem; padding-bottom: 4.5rem; }
.lyzr-why__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
.lyzr-why__item { text-align: center; }
.lyzr-why__icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 56px; height: 56px; margin-bottom: 1.1rem;
  border-radius: 16px; background: rgba(113,81,79,.08); color: #71514F;
  svg { width: 28px; height: 28px; }
}
.lyzr-why__title { margin: 0 0 .5rem; font-size: 1.2rem; font-weight: 600; color: #27272A; }
.lyzr-why__desc { margin: 0 auto; max-width: 280px; font-size: .96rem; line-height: 1.55; color: #6B5A54; }
@media (max-width: 760px) { .lyzr-why__grid { grid-template-columns: 1fr; gap: 1.75rem; } }

// FAQ
.lyzr-faq { background: #E3D0C2; }
.lyzr-faq__list { max-width: 760px; }
.lyzr-faq__item {
  padding: 1.25rem 0;
  border-bottom: 1px solid rgba(74,47,45,.14);

  summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
    font-size: 1.08rem; font-weight: 600; color: #27272A;

    &::-webkit-details-marker { display: none; }
    &::after { content: '+'; margin-left: 1rem; font-size: 1.4rem; font-weight: 400; color: #B3786E; }
  }
  &[open] summary::after { content: '\2212'; }
  p { margin: .9rem 0 0; font-size: .98rem; line-height: 1.6; color: #6B5A54; }
}

// Stats strip (under the hero — bold Playfair numbers, lyzr.ai style)
.lyzr-stats { background: #241615; padding: 2.75rem 1.5rem; }
.lyzr-stats__inner {
  max-width: 1040px; margin: 0 auto;
  display: flex; justify-content: center; align-items: flex-start; flex-wrap: wrap; gap: 2rem 3.75rem;
}
.lyzr-stat { text-align: center; }
.lyzr-stat__num {
  display: block;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(1.9rem, 3vw, 2.5rem); font-weight: 600; line-height: 1; color: #F3EFEA;
}
.lyzr-stat__label {
  display: block; margin-top: .55rem;
  font-size: .76rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
  color: rgba(227, 208, 194, .55);
}

// "More ways to work with Lyzr" — partner + lead cards
.lyzr-more { background: #E3D0C2; }
.lyzr-more__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.6rem; max-width: 900px; margin: 0 auto; }
.lyzr-more__card {
  display: block; padding: 2.2rem; border-radius: 18px;
  background: #FFFFFF; border: 1px solid #EADFD5; text-decoration: none;
  box-shadow: 0 1px 3px rgba(74,47,45,.05);
  transition: transform .28s cubic-bezier(.2,.7,.2,1), box-shadow .28s ease, border-color .28s ease;

  &:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 44px -16px rgba(74,47,45,.3);
    border-color: rgba(113,81,79,.3);
    .lyzr-more__cta { color: #4A2F2D; }
  }
  h3 { margin: 0 0 .5rem; font-size: 1.25rem; font-weight: 600; color: #27272A; }
  p { margin: 0 0 1.1rem; font-size: .96rem; line-height: 1.55; color: #6B5A54; }
}
.lyzr-more__icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 50px; height: 50px; margin-bottom: 1.2rem; border-radius: 14px;
  background: rgba(113,81,79,.08); color: #71514F;
  svg { width: 26px; height: 26px; }
}
.lyzr-more__cta { font-size: .9rem; font-weight: 600; color: #71514F; transition: color .2s ease; }
@media (max-width: 700px) { .lyzr-more__grid { grid-template-columns: 1fr; } }
