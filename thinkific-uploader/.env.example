# Copy to .env and adjust if needed. Sensible defaults are baked into src/config.mjs.
THINKIFIC_SUBDOMAIN=lyzr
# THINKIFIC_LOGIN_URL=https://lyzr.thinkific.com/manage
# THINKIFIC_ADMIN_URL=https://lyzr.thinkific.com/manage/courses
# BUNDLE_DIR=thinkific-upload                 # relative to ../ (lyzr-university)
# CATALOG=catalog-demo/catalog-data.json
# BANNER_DIR=catalog-demo/banner/exports
# ONLY=Design                                 # only upload courses whose folder matches this substring
# HEADLESS=false                              # headed by default (watch + recover from Cloudflare)
# PUBLISH=false                               # leave courses as draft; publish by hand after review
